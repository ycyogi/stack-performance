default_platform(:ios)

platform :ios do
  desc "Build an Ad Hoc IPA (for installing on registered devices)"
  lane :adhoc do
    setup_ci

    # Expect signing assets to be installed by CI steps.
    build_app(
      workspace: "ios/StackPerformance.xcworkspace",
      scheme: "StackPerformance",
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: "./artifacts",
      output_name: "StackPerformance.ipa",
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}"
    )
  end
end
