default_platform(:ios)

platform :ios do
  desc "Build & upload to TestFlight (recommended for installing on your phone)"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('APP_STORE_CONNECT_KEY_ID'),
      issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
      key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_P8'),
      is_key_content_base64: true
    )

    # Uses fastlane match for signing (recommended). Requires a separate private
    # repo to store certs/profiles.
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key
    )

    build_app(
      workspace: "ios/StackPerformance.xcworkspace",
      scheme: "StackPerformance",
      configuration: "Release",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
